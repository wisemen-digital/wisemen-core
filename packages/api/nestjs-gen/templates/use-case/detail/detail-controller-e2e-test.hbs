import { after, before, describe, it } from 'node:test'
import { randomUUID } from 'crypto'
import request from 'supertest'
import { expect } from 'expect'
import { HttpStatus } from '@nestjs/common'

describe('{{ testDescriptionName }}', () => {
  let setup: TestSetup
  let user: TestUser
  let userWithoutPermission: TestUser

  before(async () => {
    setup = await TestBench.setupEndToEndTest()
    user = await setup.authContext.getUser([Permission.{{ permissionEnumValue }}])
    userWithoutPermission = await setup.authContext.getUser([])
  })

  after(async () => {
    await setup.teardown()
  })

  it('{{ testCaseName }}', async () => {
    const response = await request(setup.httpServer)
      .get(`{{ routePath }}`)
      .set('Authorization', `Bearer ${user.token}`)

    expect(response).toHaveStatus(HttpStatus.OK)
  })

  it('returns 403 when user does not have permission', async () => {
    const response = await request(setup.httpServer)
      .get(`{{ routePath }}`)
      .set('Authorization', `Bearer ${userWithoutPermission.token}`)

    expect(response).toHaveStatus(HttpStatus.FORBIDDEN)
  })
})
