{
  "name": "@wisemen/nestjs-one-signal",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "lint:oxlint": "oxlint --type-aware lib",
    "lint:eslint": "eslint lib",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "clean": "rm -rf ./dist",
    "build": "tsc",
    "pretest": "pnpm build",
    "test": "node --test ./dist/lib/**/*.test.js",
    "prerelease": "npm run build",
    "release": "pnpx release-it"
  },
  "dependencies": {
    "@nestjs/jwt": "catalog:backend",
    "@onesignal/node-onesignal": "catalog:backend",
    "@wisemen/api-error": "workspace:*",
    "@wisemen/opentelemetry": "workspace:*",
    "@wisemen/validators": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "catalog:backend-peer",
    "@nestjs/swagger": "catalog:backend-peer",
    "class-transformer": "catalog:backend-peer",
    "class-validator": "catalog:backend-peer",
    "dayjs": "catalog:backend-peer"
  },
  "devDependencies": {
    "@types/node": "catalog:backend",
    "@wisemen/eslint-config-nestjs": "workspace:*",
    "eslint": "catalog:lint-api",
    "oxlint": "catalog:lint-api",
    "oxlint-tsgolint": "catalog:lint-api",
    "typescript": "catalog:peer"
  },
  "author": "Wisemen",
  "license": "GPL",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisemen-digital/wisemen-core",
    "directory": "packages/api/nestjs-one-signal"
  }
}