{
  "name": "@wisemen/nestjs-custom-fields",
  "version": "0.0.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#src/*": "./dist/*"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/",
    "skills/"
  ],
  "scripts": {
    "lint:oxlint": "oxlint --type-aware lib",
    "lint:eslint": "eslint lib",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "clean": "rm -rf ./dist",
    "build": "tsc",
    "pretest": "pnpm build",
    "test": "node --test ./dist/**/*.test.js",
    "prerelease": "npm run build",
    "release": "pnpx release-it"
  },
  "dependencies": {
    "@wisemen/monetary": "workspace:^*",
    "@wisemen/datewise": "workspace:^*",
    "@wisemen/localized-string": "workspace:^*",
    "@wisemen/api-error": "workspace:^*",
    "@wisemen/validators": "workspace:^*",
    "@wisemen/nestjs-typeorm": "workspace:^*"
  },
  "peerDependencies": {
    "@nestjs/swagger": "catalog:backend-peer",
    "class-transformer": "catalog:backend-peer",
    "class-validator": "catalog:backend-peer",
    "@nestjs/common": "catalog:backend-peer",
    "@nestjs/core": "catalog:backend-peer",
    "@opentelemetry/api": "catalog:backend-peer",
    "typeorm": "catalog:backend-peer"
  },
  "devDependencies": {
    "@types/node": "catalog:backend",
    "@wisemen/eslint-config-nestjs": "workspace:*",
    "eslint": "catalog:lint-api",
    "oxlint": "catalog:lint-api",
    "oxlint-tsgolint": "catalog:lint-api",
    "typescript": "catalog:peer",
    "expect": "catalog:test"
  },
  "author": "Wisemen",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisemen-digital/wisemen-core",
    "directory": "packages/api/nestjs-custom-fields"
  }
}
