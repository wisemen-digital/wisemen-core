{
  "name": "@wisemen/nestjs-swagger",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/",
    "skills/"
  ],
  "scripts": {
    "lint:oxlint": "oxlint --type-aware lib",
    "lint:eslint": "eslint lib",
    "lint": "npm run lint:oxlint && npm run lint:eslint",
    "prebuild": "rm -rf ./dist",
    "clean": "rm -rf ./dist",
    "build": "tsc && node ./scripts/copy-assets.mjs",
    "pretest": "npm run clean && npm run build",
    "test": "node --experimental-test-isolation=none --test ./**/*.test.js",
    "prerelease": "npm run build",
    "release": "pnpx release-it"
  },
  "peerDependencies": {
    "@nestjs/common": "catalog:backend-peer",
    "@nestjs/core": "catalog:backend-peer",
    "@nestjs/swagger": "catalog:backend-peer",
    "reflect-metadata": "catalog:backend-peer",
    "fastify": "catalog:backend-peer",
    "@wisemen/api-error": "workspace:^",
    "@wisemen/nestjs-common": "workspace:^",
    "@wisemen/nestjs-auth": "workspace:^",
    "@wisemen/opentelemetry": "workspace:^"
  },
  "dependencies": {
    "swagger-ui-dist": "5.32.8"
  },
  "devDependencies": {
    "@nestjs/platform-fastify": "catalog:backend",
    "@types/node": "catalog:backend",
    "@wisemen/eslint-config-nestjs": "workspace:*",
    "eslint": "catalog:lint-api",
    "expect": "catalog:test",
    "oxlint": "catalog:lint-api",
    "oxlint-tsgolint": "catalog:lint-api",
    "typescript": "catalog:peer"
  },
  "author": "Kobe Kwanten",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisemen-digital/wisemen-core",
    "directory": "packages/api/nestjs-swagger"
  }
}
