{
  "name": "@wisemen/csv",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/",
    "skills/"
  ],
  "scripts": {
    "lint:oxlint": "oxlint --type-aware lib",
    "lint:eslint": "eslint lib",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "prebuild": "rm -rf ./dist",
    "clean": "rm -rf ./dist",
    "build": "tsc",
    "pretest": "npm run clean && npm run build",
    "test": "node --env-file=.env.test --experimental-test-isolation=none --test dist/**/*.test.js",
    "prerelease": "npm run build",
    "release": "pnpx release-it"
  },
  "devDependencies": {
    "@types/node": "catalog:backend",
    "@wisemen/eslint-config-nestjs": "workspace:*",
    "eslint": "catalog:lint-api",
    "oxlint": "catalog:lint-api",
    "oxlint-tsgolint": "catalog:lint-api",
    "expect": "catalog:test",
    "pg": "catalog:backend",
    "typeorm": "catalog:backend",
    "typescript": "catalog:peer",
    "pg-query-stream": "catalog:backend"
  },
  "author": "Maarten Sijmkens",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisemen-digital/wisemen-core",
    "directory": "packages/csv"
  }
}
