{
  "name": "@wisemen/nestjs-tests",
  "version": "0.0.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#src/*": "./dist/*"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "lint:oxlint": "oxlint --type-aware lib",
    "lint:eslint": "eslint lib",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "clean": "rm -rf ./dist",
    "build": "tsc",
    "pretest": "pnpm build",
    "test": "node --test ./dist/lib/**/*.test.js",
    "prerelease": "npm run build",
    "release": "pnpx release-it"
  },
  "dependencies": {
    "expect": "catalog:test",
    "sinon": "catalog:test"
  },
  "peerDependencies": {
    
  },
  "devDependencies": {
  },
  "author": "Wisemen",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisemen-digital/wisemen-core",
    "directory": "packages/api/nestjs-nats"
  }
}
