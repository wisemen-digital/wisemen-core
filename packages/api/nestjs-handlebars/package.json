{
  "name": "@wisemen/nestjs-handlebars",
  "version": "0.0.2",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/"
  ],
  "scripts": {
    "lint:oxlint": "oxlint --type-aware lib",
