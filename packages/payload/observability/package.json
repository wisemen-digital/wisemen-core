{
  "name": "@wisemen/payload-core-observability",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "imports": {
    "#*": "./src/*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wisemen-digital/wisemen-core",
    "directory": "packages/payload/observability"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typings": "./dist/index.d.mts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "pnpm build",
    "cleanup": "rimraf dist/ node_modules/ .turbo/",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "evlog": "^2.26.0"
  },
  "peerDependencies": {
    "@orpc/otel": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "payload": "catalog:payload-peer"
  },
  "devDependencies": {
    "@orpc/otel": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@wisemen/eslint-config-vue": "workspace:*",
    "eslint": "catalog:lint-web",
    "payload": "catalog:payload",
    "rimraf": "catalog:build",
    "tsdown": "catalog:build",
    "typescript": "catalog:build"
  }
}
