{
  "name": "@wisemen/payload-core-form-builder",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "imports": { "#*": "./src/*" },
  "repository": { "type": "git", "url": "https://github.com/wisemen-digital/wisemen-core", "directory": "packages/payload/form-builder" },
  "exports": {
    ".": { "types": "./dist/index.d.mts", "import": "./dist/index.mjs" },
    "./admin": { "types": "./dist/admin/index.d.mts", "import": "./dist/admin/index.mjs" },
    "./seeders/contact": { "types": "./dist/seeders/contactForm.seed.d.mts", "import": "./dist/seeders/contactForm.seed.mjs" }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typings": "./dist/index.d.mts",
  "sideEffects": false,
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "pnpm build",
    "cleanup": "rimraf dist/ node_modules/ .turbo/",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@payloadcms/ui": "catalog:payload-peer",
    "@wisemen/payload-core-utils": "workspace:^",
    "@orpc/contract": "catalog:payload",
    "payload": "catalog:payload-peer",
    "react": "catalog:payload-peer",
    "zod": "catalog:general"
  },
  "devDependencies": {
    "@payloadcms/ui": "catalog:payload",
    "@types/node": "catalog:types",
    "@types/react": "catalog:payload",
    "@wisemen/payload-core-utils": "workspace:^",
    "@orpc/contract": "catalog:payload",
    "eslint": "catalog:lint-web",
    "payload": "catalog:payload",
    "react": "catalog:payload",
    "rimraf": "catalog:build",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "@wisemen/payload-core-seeder": "workspace:^",
    "zod": "catalog:general"
  }
}
