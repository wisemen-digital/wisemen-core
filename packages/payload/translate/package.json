{
  "name": "@wisemen/payload-core-translate",
  "type": "module",
  "version": "0.0.0",
  "private": false,
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typings": "./dist/index.d.mts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "pnpm build",
    "cleanup": "rimraf dist/ node_modules/ .turbo/",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "lint:fix": "eslint --fix"
  },
  "peerDependencies": {
    "@payloadcms/ui": "catalog:payload",
    "payload": "catalog:payload",
    "react": "catalog:payload"
  },
  "dependencies": {
  },
  "devDependencies": {
    "@payloadcms/ui": "catalog:payload",
    "payload": "catalog:payload",
    "react": "catalog:payload",
    "@types/react": "catalog:payload",
    "@wisemen/eslint-config-vue": "workspace:*",
    "eslint": "catalog:lint-web",
    "rimraf": "catalog:build",
    "tsdown": "catalog:build",
    "typescript": "catalog:build"
  }
}
