{
  "compilerOptions": {
    "target": "ES2017",
    "jsx": "react-jsx",
    "ignoreDeprecations": "5.0",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "#*": [
        "./src/*"
      ],
      "@wisemen/payload-core-translate/client": ["./src/client.ts"],
      "@wisemen/payload-core-translate/server": ["./src/server.ts"]
    },
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
