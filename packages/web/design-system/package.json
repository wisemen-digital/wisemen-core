{
  "name": "@wisemen/vue-core-design-system",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "version": "1.17.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisemen-digital/wisemen-core",
    "directory": "packages/design-system"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "style": "./dist/index.css"
    },
    "./locales": {
      "types": "./dist/locales.d.ts",
      "import": "./dist/locales.js"
    },
    "./style.css": "./dist/style.css"
  },
  "style": "./dist/index.css",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "files": [
    "./dist",
    "./skills"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "pub:release": "pnpm publish --access public",
    "pub:beta": "pnpm publish --no-git-checks --access public --tag beta",
    "pub:next": "pnpm publish --no-git-checks --access public --tag next",
    "cleanup": "rimraf dist/ node_modules/ .turbo/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "bench": "vitest run --config vitest.bench.config.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --run --coverage",
    "type-check": "vue-tsc --noEmit",
    "storybook:clean": "rimraf node_modules/.cache node_modules/.vite",
    "storybook": "pnpm storybook:clean && NODE_OPTIONS=--max-old-space-size=8192 storybook dev -p 6006 --no-open",
    "story:build": "NODE_OPTIONS=--max-old-space-size=8192 storybook build"
  },
  "peerDependencies": {
    "@internationalized/date": "catalog:date",
    "@tanstack/vue-table": "^8.20.0",
    "@tanstack/vue-virtual": "^3.0.0",
    "@vueuse/core": "catalog:vue",
    "@vueuse/router": "catalog:vue",
    "@wisemen/vue-core-actions": "workspace:^",
    "@wisemen/vue-core-dates": "workspace:^",
    "formango": "workspace:^",
    "motion-v": "catalog:peer",
    "pinia": "catalog:vue",
    "reka-ui": "catalog:peer",
    "temporal-polyfill": "catalog:peer",
    "vue": "catalog:peer",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "catalog:peer",
    "vue-router": "catalog:peer",
    "vue-sonner": "catalog:vue",
    "zod": "catalog:general"
  },
  "dependencies": {
    "@tailwindcss/vite": "catalog:vite",
    "@wisemen/vue-core-api-utils": "workspace:*",
    "blurhash": "catalog:general",
    "@wisemen/vue-core-icons": "workspace:*",
    "@wisemen/vue-core-utils": "workspace:*",
    "@wisemen/vue-core-dates": "workspace:*",
    "country-flag-icons": "catalog:general",
    "libphonenumber-js": "catalog:general",
    "vite": "catalog:vite",
    "maska": "catalog:general",
    "tailwind-merge": "catalog:style",
    "tailwind-variants": "catalog:style",
    "tailwindcss": "catalog:style",
    "vue-component-meta": "catalog:storybook",
    "vue-component-type-helpers": "catalog:types",
    "vue-sonner": "catalog:vue"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "catalog:storybook",
    "@internationalized/date": "catalog:date",
    "@storybook/addon-a11y": "catalog:storybook",
    "@storybook/addon-docs": "catalog:storybook",
    "@storybook/addon-vitest": "catalog:storybook",
    "@storybook/vue3": "catalog:storybook",
    "@storybook/vue3-vite": "catalog:storybook",
    "@tanstack/vue-hotkeys": "catalog:",
    "@tanstack/vue-table": "catalog:",
    "@tanstack/vue-virtual": "catalog:",
    "@types/node": "catalog:types",
    "@vitejs/plugin-vue": "catalog:vite",
    "@vitest/browser-playwright": "catalog:test",
    "@vitest/coverage-v8": "catalog:test",
    "@vue/test-utils": "catalog:test",
    "@wisemen/eslint-config-vue": "workspace:*",
    "@wisemen/vue-core-actions": "workspace:*",
    "@wisemen/vue-core-dates": "workspace:*",
    "@wisemen/vue-core-tailwind-config": "workspace:*",
    "eslint": "catalog:lint-web",
    "eslint-plugin-storybook": "catalog:storybook",
    "formango": "workspace:*",
    "jsdom": "catalog:test",
    "motion-v": "catalog:peer",
    "pinia": "catalog:vue",
    "playwright": "catalog:test",
    "reka-ui": "catalog:vue",
    "storybook": "catalog:storybook",
    "typescript": "catalog:build",
    "vite-plugin-dts": "catalog:vite",
    "vitest": "catalog:test",
    "@vue/tsconfig": "catalog:vue",
    "vue": "catalog:vue",
    "vue-draggable-plus": "catalog:",
    "vue-router": "catalog:peer",
    "vue-tsc": "catalog:vue",
    "zod": "catalog:general"
  }
}
