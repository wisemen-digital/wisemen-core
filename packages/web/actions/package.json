{
  "name": "@wisemen/vue-core-actions",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "version": "0.1.1",
  "private": false,
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisemen-digital/wisemen-core",
    "directory": "packages/web/actions"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locales": {
      "types": "./dist/locales.d.ts",
      "import": "./dist/locales.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "imports": {
    "#*": "./src/*"
  },
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "files": [
    "./dist"
  ],
  "scripts": {
    "build": "vite build",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "pub:release": "pnpm publish --access public",
    "test:unit": "vitest --run",
    "test": "vitest --run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cleanup": "rimraf dist/ node_modules/ .turbo/"
  },
  "peerDependencies": {
    "vue": "catalog:peer",
    "pinia": "catalog:vue",
    "vue-i18n": "catalog:peer"
  },
  "devDependencies": {
    "@tanstack/vue-hotkeys": "catalog:",
    "@types/node": "catalog:types",
    "@vitejs/plugin-vue": "catalog:vite",
    "@vueuse/core": "catalog:vue",
    "@vue/test-utils": "catalog:test",
    "@vue/tsconfig": "catalog:vue",
    "@wisemen/eslint-config-vue": "workspace:*",
    "@wisemen/vue-core-icons": "catalog:wisemen",
    "eslint": "catalog:lint-web",
    "pinia": "catalog:vue",
    "husky": "catalog:build",
    "typescript": "catalog:build",
    "vite": "catalog:vite",
    "vite-plugin-dts": "catalog:vite",
    "vitest": "catalog:test",
    "vue": "catalog:vue",
    "vue-tsc": "catalog:vue"
  }
}
