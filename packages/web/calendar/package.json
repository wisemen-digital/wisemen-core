{
  "name": "@wisemen/vue-core-calendar",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisemen-digital/wisemen-core",
    "directory": "packages/web/calendar"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "files": [
    "./dist"
  ],
  "scripts": {
    "build": "vite build",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "test:unit": "vitest --run",
    "test": "vitest --run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "storybook": "NODE_OPTIONS=--max-old-space-size=8192 storybook dev -p 6007 --no-open",
    "build-storybook": "NODE_OPTIONS=--max-old-space-size=8192 storybook build",
    "story:build": "NODE_OPTIONS=--max-old-space-size=8192 storybook build",
    "cleanup": "rimraf dist/ node_modules/ .turbo/"
  },
  "peerDependencies": {
    "@wisemen/vue-core-dates": "workspace:*",
    "@wisemen/vue-core-design-system": "workspace:*",
    "temporal-polyfill": "catalog:peer",
    "vue": "catalog:peer"
  },
  "dependencies": {
    "@wisemen/vue-core-icons": "workspace:*"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "catalog:storybook",
    "@storybook/addon-a11y": "catalog:storybook",
    "@storybook/addon-docs": "catalog:storybook",
    "@storybook/addon-vitest": "catalog:storybook",
    "@storybook/vue3-vite": "catalog:storybook",
    "@tailwindcss/vite": "catalog:vite",
    "@types/node": "catalog:types",
    "@vitejs/plugin-vue": "catalog:vite",
    "@vue/test-utils": "catalog:test",
    "@vue/tsconfig": "catalog:vue",
    "@wisemen/eslint-config-vue": "workspace:*",
    "@wisemen/vue-core-dates": "workspace:*",
    "@wisemen/vue-core-design-system": "workspace:*",
    "@wisemen/vue-core-tailwind-config": "workspace:*",
    "eslint": "catalog:lint-web",
    "storybook": "catalog:storybook",
    "tailwindcss": "catalog:style",
    "temporal-polyfill": "catalog:peer",
    "typescript": "catalog:build",
    "vite": "catalog:vite",
    "vite-plugin-dts": "catalog:vite",
    "vitest": "catalog:test",
    "vue": "catalog:vue",
    "vue-tsc": "catalog:vue"
  }
}
