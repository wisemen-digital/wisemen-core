{
  "name": "@wisemen/vue-core-custom-views",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "version": "0.0.1",
  "private": false,
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisemen-digital/wisemen-core",
    "directory": "packages/web/custom-views"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locales": {
      "types": "./dist/locales.d.ts",
      "import": "./dist/locales.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "files": [
    "./dist"
  ],
  "scripts": {
    "build": "vite build",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "pub:release": "pnpm publish --access public",
    "pub:beta": "pnpm publish --no-git-checks --access public --tag beta",
    "pub:next": "pnpm publish --no-git-checks --access public --tag next",
    "test:unit": "vitest --run",
    "test": "vitest --run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cleanup": "rimraf dist/ node_modules/ .turbo/"
  },
  "peerDependencies": {
    "@tanstack/vue-hotkeys": "catalog:",
    "@vueuse/core": "catalog:vue",
    "@vueuse/router": "catalog:vue",
    "@wisemen/vue-core-actions": ">=0.1.3",
    "@wisemen/vue-core-design-system": ">=0.10.0",
    "@wisemen/vue-core-filters": ">=5.0.0",
    "@wisemen/vue-core-icons": ">=0.0.2",
    "@wisemen/vue-core-utils": ">=0.1.0",
    "formango": "catalog:peer",
    "reka-ui": "catalog:peer",
    "tailwindcss": "catalog:style",
    "vue": "catalog:peer",
    "vue-i18n": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "@wisemen/vue-core-filters": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:vite",
    "@tanstack/vue-hotkeys": "catalog:",
    "@types/node": "catalog:types",
    "@vitejs/plugin-vue": "catalog:vite",
    "@vue/test-utils": "catalog:test",
    "@vue/tsconfig": "catalog:vue",
    "@vueuse/core": "catalog:vue",
    "@vueuse/router": "catalog:vue",
    "@wisemen/eslint-config-vue": "workspace:*",
    "@wisemen/vue-core-actions": "workspace:*",
    "@wisemen/vue-core-design-system": "workspace:*",
    "@wisemen/vue-core-filters": "workspace:*",
    "@wisemen/vue-core-icons": "workspace:*",
    "@wisemen/vue-core-tailwind-config": "workspace:*",
    "@wisemen/vue-core-utils": "workspace:*",
    "eslint": "catalog:lint-web",
    "formango": "catalog:peer",
    "reka-ui": "catalog:vue",
    "tailwindcss": "catalog:style",
    "typescript": "catalog:build",
    "vite": "catalog:vite",
    "vite-plugin-dts": "catalog:vite",
    "vitest": "catalog:test",
    "vue": "catalog:vue",
    "vue-i18n": "catalog:peer",
    "vue-tsc": "catalog:vue"
  }
}
